# Environment variables for CRM Assistant Frontend
# Copy this file to .env and fill in your actual values

# API URLs
VITE_API_HTTP_URL=http://localhost:8000
VITE_API_WS_URL=ws://localhost:8000/ws/chat

# API Keys - Get these from your respective service providers
VITE_GROQ_API_KEY=your_groq_api_key_here

# Staff Configuration (optional)
VITE_STAFF_TYPE=
VITE_STAFF_NAME=
