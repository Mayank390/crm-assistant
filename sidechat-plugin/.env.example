# Lead Support Agent Plugin Configuration
# Copy this file to .env and update the values

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ============================================
# REQUIRED: Update these with your actual IDs
# ============================================

# Your Business UUID
# Example: 1eedcb26-d23a-688a-bd63-579d19dab229
VITE_BUSINESS_ID=YOUR_BUSINESS_ID_HERE

# Lead ObjectId or UUID to focus on
# Example: 507f1f77bcf86cd799439011 (MongoDB ObjectId)
# Example: 1eedcb26-d23a-688a-bd63-579d19dab229 (UUID)
VITE_LEAD_ID=YOUR_LEAD_ID_HERE

# Your Member/User UUID for authentication
# Example: 1eedcb26-d23a-688a-bd63-579d19dab229
VITE_MEMBER_ID=YOUR_MEMBER_ID_HERE
